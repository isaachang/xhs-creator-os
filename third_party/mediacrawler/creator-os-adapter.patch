+    @staticmethod
+    def _engagement_score(value: object) -> float:
+        """Sort human-readable engagement snapshots without treating unknown as zero."""
+        if value is None:
+            return -1.0
+        if isinstance(value, (int, float)):
+            return float(value)
+        text = str(value).strip().lower().replace(",", "")
+        if not text:
+            return -1.0
+        multiplier = 1.0
+        if text.endswith("万"):
+            multiplier, text = 10000.0, text[:-1]
+        elif text.endswith("w"):
+            multiplier, text = 10000.0, text[:-1]
+        elif text.endswith("k"):
+            multiplier, text = 1000.0, text[:-1]
+        try:
+            return float(text) * multiplier
+        except ValueError:
+            return -1.0
