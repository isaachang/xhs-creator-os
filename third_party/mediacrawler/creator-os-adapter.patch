+++ b/media_platform/xhs/site.py
@@ -0,0 +1,57 @@
+"""Site selection for domestic Xiaohongshu and overseas Rednote sessions.
+
+The crawler stores only the resolved site name beside its dedicated browser
+profile. Cookie values are never read into this metadata file.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from urllib.parse import urlparse
+
+
+DOMESTIC = "xiaohongshu"
+INTERNATIONAL = "rednote"
+_VALID_SITES = {DOMESTIC, INTERNATIONAL}
+
+
+def site_from_url(url: str) -> str | None:
+    host = (urlparse(url).hostname or "").lower()
+    if host == "rednote.com" or host.endswith(".rednote.com"):
+        return INTERNATIONAL
+    if host == "xiaohongshu.com" or host.endswith(".xiaohongshu.com"):
+        return DOMESTIC
+    return None
+
+
+def site_from_cookie_domains(domains: list[str]) -> str | None:
+    """Infer a site only when its cookie domain is unambiguous."""
+    sites = {site_from_url(f"https://{domain.lstrip('.')}") for domain in domains}
+    sites.discard(None)
+    return next(iter(sites)) if len(sites) == 1 else None
+
+
+def site_url(site: str) -> str:
+    if site == INTERNATIONAL:
+        return "https://www.rednote.com"
+    return "https://www.xiaohongshu.com"
+
+
+def is_international(site: str) -> bool:
+    return site == INTERNATIONAL
+
+
+def load_saved_site(path: Path) -> str | None:
+    try:
+        value = json.loads(path.read_text(encoding="utf-8")).get("site")
+    except (OSError, ValueError, AttributeError):
+        return None
+    return value if value in _VALID_SITES else None
+
+
+def save_site(path: Path, site: str) -> None:
+    if site not in _VALID_SITES:
+        return
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps({"site": site}, ensure_ascii=False), encoding="utf-8")
