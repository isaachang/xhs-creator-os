+                    crawl_interval=config.CRAWLER_MAX_SLEEP_SEC,
+                    xsec_token=creator_info.xsec_token,
+                    xsec_source=creator_info.xsec_source,
+                )
+            except ValueError as exc:
+                utils.logger.error("[XiaoHongShuCrawler.get_creator_top_notes] Invalid creator URL: %s", exc)
+                continue
+            except (IPBlockError, PlatformAccessError) as exc:
+                utils.logger.error("[XiaoHongShuCrawler.get_creator_top_notes] Creator access restricted: %s", exc)
+                continue
+
+            raw_cards.extend(cards)
+            scanned_count += len(cards)
+            normalized_cards = [normalize_creator_card(card, creator_profile_url=creator_url) for card in cards]
+            ranked_cards = sorted(
+                normalized_cards,
+                key=lambda record: self._engagement_score(record.get("saves")),
+                reverse=True,
+            )
+            selected_cards = ranked_cards[: config.XHS_CREATOR_TOP_LIMIT]
+            raw_by_id = {str(card.get("note_id") or card.get("id") or ""): card for card in cards}
