@@ -0,0 +1,36 @@
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from media_platform.xhs.site import (
+    DOMESTIC,
+    INTERNATIONAL,
+    load_saved_site,
+    save_site,
+    site_from_cookie_domains,
+    site_from_url,
+)
+
+
+class SiteDetectionTests(unittest.TestCase):
+    def test_detects_supported_urls(self):
+        self.assertEqual(site_from_url("https://www.rednote.com/explore/a"), INTERNATIONAL)
+        self.assertEqual(site_from_url("https://www.xiaohongshu.com/explore/a"), DOMESTIC)
+        self.assertIsNone(site_from_url("https://example.com"))
+
+    def test_requires_unambiguous_cookie_domains(self):
+        self.assertEqual(site_from_cookie_domains([".rednote.com"]), INTERNATIONAL)
+        self.assertEqual(site_from_cookie_domains([".xiaohongshu.com"]), DOMESTIC)
+        self.assertIsNone(site_from_cookie_domains([".rednote.com", ".xiaohongshu.com"]))
+
+    def test_persists_only_site_name(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "creator_os_site.json"
+            save_site(path, INTERNATIONAL)
+            self.assertEqual(load_saved_site(path), INTERNATIONAL)
+            self.assertEqual(json.loads(path.read_text(encoding="utf-8")), {"site": INTERNATIONAL})
+
+
+if __name__ == "__main__":
+    unittest.main()
