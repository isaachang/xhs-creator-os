diff --git a/media_platform/xhs/creator_os_output.py b/media_platform/xhs/creator_os_output.py
new file mode 100644
index 0000000..43a7cfe
--- /dev/null
+++ b/media_platform/xhs/creator_os_output.py
@@ -0,0 +1,196 @@
+"""Creator OS search-card output adapter for the local MediaCrawler fork.
+
+This adapter intentionally records public search-card fields before any note
+detail request. It keeps the provider payload locally for traceability while
+emitting the stable schema consumed by xhs-creator-os research runs.
+"""
+
+from __future__ import annotations
+
+import json
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Iterable
+from urllib.parse import urlencode
+
+import config
+
+
+def _note_type(value: Any) -> str:
+    normalized = str(value or "").lower()
+    if normalized in {"video", "1"}:
+        return "video"
+    if normalized in {"normal", "image", "images", "2"}:
+        return "image"
+    return "unknown"
+
+
+def _first_publish_text(note_card: dict[str, Any]) -> str:
+    for tag in note_card.get("corner_tag_info") or []:
+        if tag.get("type") == "publish_time" and tag.get("text"):
+            return str(tag["text"])
+    return ""
+
+
+def _url(path: str, token: str, source: str) -> str:
+    domain = "https://www.rednote.com" if config.XHS_INTERNATIONAL else "https://www.xiaohongshu.com"
+    query = {"xsec_token": token, "xsec_source": source}
+    query = {key: value for key, value in query.items() if value}
+    suffix = f"?{urlencode(query)}" if query else ""
+    return f"{domain}{path}{suffix}"
+
+
+def normalize_search_card(card: dict[str, Any], query: str) -> dict[str, Any]:
+    """Map one untouched XHS/Rednote search card to Creator OS fields."""
+    note_card = card.get("note_card") or {}
+    user = note_card.get("user") or {}
+    note_id = str(card.get("id") or "")
+    note_token = str(card.get("xsec_token") or "")
+    source = str(card.get("xsec_source") or "pc_search")
+    user_id = str(user.get("user_id") or "")
+    user_token = str(user.get("xsec_token") or "")
+    interact = note_card.get("interact_info") or {}
+
+    return {
+        "note_id": note_id,
+        "url": _url(f"/explore/{note_id}", note_token, source) if note_id else "",
+        "title": note_card.get("display_title") or "",
+        "body": "",
+        "author_id": user_id,
+        "author_name": user.get("nickname") or user.get("nick_name") or "",
+        "author_url": _url(f"/user/profile/{user_id}", user_token, source) if user_id else "",
+        "published_at": _first_publish_text(note_card),
+        "note_type": _note_type(note_card.get("type")),
+        "content_level": "card",
+        "detail_status": "not_requested",
+        "captured_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
+        "query": query,
+        "source": "mediacrawler-rednote" if config.XHS_INTERNATIONAL else "mediacrawler-xiaohongshu",
+        "likes": interact.get("liked_count"),
+        "saves": interact.get("collected_count"),
+        "comments": interact.get("comment_count"),
+        "shares": interact.get("shared_count"),
+        "raw": card,
+    }
+
+
+def normalize_creator_detail(
+    detail: dict[str, Any],
+    *,
+    creator_profile_url: str,
+) -> dict[str, Any]:
+    """Map an author-feed detail response to the Creator OS research schema."""
+    user = detail.get("user") or {}
+    interact = detail.get("interact_info") or {}
+    note_id = str(detail.get("note_id") or "")
+    token = str(detail.get("xsec_token") or "")
+    source = str(detail.get("xsec_source") or "pc_user")
+    timestamp = detail.get("time")
+    published_at = ""
+    if isinstance(timestamp, (int, float)):
+        # XHS uses milliseconds in the creator-feed response.
+        try:
+            published_at = datetime.fromtimestamp(timestamp / 1000, tz=timezone.utc).date().isoformat()
+        except (OverflowError, OSError, ValueError):
+            pass
+
+    return {
+        "note_id": note_id,
+        "url": _url(f"/explore/{note_id}", token, source) if note_id else "",
+        "title": detail.get("title") or detail.get("desc", "")[:80],
+        "body": detail.get("desc") or "",
+        "author_id": str(user.get("user_id") or ""),
+        "author_name": user.get("nickname") or user.get("nick_name") or "",
+        "author_url": creator_profile_url,
+        "published_at": published_at,
+        "note_type": _note_type(detail.get("type")),
+        "content_level": "detail",
+        "detail_status": "success",
+        "captured_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
+        "query": "",
+        "source": "mediacrawler-creator-rednote" if config.XHS_INTERNATIONAL else "mediacrawler-creator-xiaohongshu",
+        "likes": interact.get("liked_count"),
+        "saves": interact.get("collected_count"),
+        "comments": interact.get("comment_count"),
+        "shares": interact.get("share_count"),
+        "raw": detail,
+    }
+
+
+def normalize_note_detail(detail: dict[str, Any], *, query: str = "") -> dict[str, Any]:
+    """Map a specified-note detail response to the shared Creator OS schema."""
+    user = detail.get("user") or {}
+    interact = detail.get("interact_info") or {}
+    note_id = str(detail.get("note_id") or "")
+    note_token = str(detail.get("xsec_token") or "")
+    source = str(detail.get("xsec_source") or "pc_search")
+    user_id = str(user.get("user_id") or "")
+    user_token = str(user.get("xsec_token") or "")
+    published_at = ""
+    timestamp = detail.get("time")
+    if isinstance(timestamp, (int, float)):
+        try:
+            published_at = datetime.fromtimestamp(timestamp / 1000, tz=timezone.utc).date().isoformat()
+        except (OverflowError, OSError, ValueError):
+            pass
+
+    return {
+        "note_id": note_id,
+        "url": _url(f"/explore/{note_id}", note_token, source) if note_id else "",
+        "title": detail.get("title") or detail.get("desc", "")[:80],
+        "body": detail.get("desc") or "",
+        "author_id": user_id,
+        "author_name": user.get("nickname") or user.get("nick_name") or "",
+        "author_url": _url(f"/user/profile/{user_id}", user_token, source) if user_id else "",
+        "published_at": published_at,
+        "note_type": _note_type(detail.get("type")),
+        "content_level": "detail",
+        "detail_status": "success",
+        "captured_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
+        "query": query,
+        "source": "mediacrawler-rednote" if config.XHS_INTERNATIONAL else "mediacrawler-xiaohongshu",
+        "likes": interact.get("liked_count"),
+        "saves": interact.get("collected_count"),
+        "comments": interact.get("comment_count"),
+        "shares": interact.get("shared_count") or interact.get("share_count"),
+        "raw": detail,
+    }
+
+
+def write_creator_os_run(
+    records: Iterable[dict[str, Any]],
+    output_path: str,
+    *,
+    raw_cards: Iterable[dict[str, Any]] | None = None,
+    screening: Any | None = None,
+    metadata: dict[str, Any] | None = None,
+) -> None:
+    """Write final results, untouched candidates, and optional screening decisions atomically."""
+    if not output_path:
+        return
+
+    normalized = list(records)
+    target = Path(output_path).expanduser()
+    target.parent.mkdir(parents=True, exist_ok=True)
+    raw_target = target.with_name(f"{target.stem}.raw{target.suffix or '.json'}")
+    raw_records = list(raw_cards) if raw_cards is not None else [record.get("raw", {}) for record in normalized]
+
+    for path, payload in ((target, normalized), (raw_target, raw_records)):
+        temp = path.with_name(f".{path.name}.tmp")
+        temp.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
+        temp.replace(path)
+    if screening is not None:
+        screening_target = target.with_name(f"{target.stem}.screening{target.suffix or '.json'}")
+        temp = screening_target.with_name(f".{screening_target.name}.tmp")
+        temp.write_text(json.dumps(screening, ensure_ascii=False, indent=2), encoding="utf-8")
+        temp.replace(screening_target)
+    manifest_target = target.with_name(f"{target.stem}.manifest{target.suffix or '.json'}")
+    manifest = {
+        "provider": "media",
+        "site": "rednote" if config.XHS_INTERNATIONAL else "xiaohongshu",
+        "returned_count": len(normalized),
+        **(metadata or {}),
+    }
+    temp = manifest_target.with_name(f".{manifest_target.name}.tmp")
+    temp.write_text(json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8")
+    temp.replace(manifest_target)
