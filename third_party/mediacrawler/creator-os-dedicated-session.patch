+    async def _creator_os_work_page(self) -> Page:
+        """Reuse one dedicated page so each detail read does not create a new tab."""
+        if config.CREATOR_OS_SHARED_BROWSER:
+            open_pages = [page for page in self.browser_context.pages if not page.is_closed()]
+            if open_pages:
+                # Login retries and a previous upstream run can leave Rednote
+                # tabs behind. One long-lived page is sufficient for every
+                # Creator OS worker, so collapse stale pages before starting.
+                work_page = next((page for page in open_pages if page.url == "about:blank"), open_pages[0])
+                for page in open_pages:
+                    if page is work_page:
+                        continue
+                    try:
+                        await page.close()
+                    except Exception:
+                        pass
+                utils.logger.info("[XiaoHongShuCrawler] Reusing one Creator OS dedicated work page")
+                return work_page
+        utils.logger.info("[XiaoHongShuCrawler] Creating Creator OS dedicated work page")
+        return await self.browser_context.new_page()
+
