+    async def _browser_session_confirmed(self) -> bool:
+        """Confirm the signed-in navigation without reading cookie values.
+
+        Rednote can return an inconclusive ``selfinfo`` API response in a
+        headless context even while its dedicated browser Profile is valid.
+        This is only used for that unknown state; an explicit API logout still
+        requires QR login.
+        """
+        selector = (
+            "xpath=//a[contains(@href, '/user/profile/')]"
+            "//span[normalize-space()='我' or normalize-space()='Me']"
+        )
+        try:
+            return await self.context_page.is_visible(selector, timeout=1_000)
+        except Exception:
+            return False
